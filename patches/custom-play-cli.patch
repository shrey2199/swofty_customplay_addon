+pub(crate) fn configured_loader(store: &Store, game: &Path) -> Option<PathBuf> {
+    std::env::var_os("SWOFTY_CUSTOM_LOADER")
+        .or_else(|| std::env::var_os("SWOFTY_CUSTOM_BATCH"))
+        .map(PathBuf::from)
+        .or_else(|| store.config().launch.custom_batch(game).map(Path::to_path_buf))
+}
+
+fn custom_loader(store: &Store, game: &Path) -> Result<Option<PathBuf>> {
+    let Some(loader) = configured_loader(store, game) else {
+        return Ok(None);
+    };
+    if !cfg!(windows) {
+        bail!("Custom loader launch is only available on Windows");
+    }
+    if !game.join(GAME_EXE).is_file() {
+        bail!("{} is missing from {}", GAME_EXE, game.display());
+    }
+    let extension = loader.extension();
+    let batch = extension.is_some_and(|ext| ext.eq_ignore_ascii_case("bat"));
+    let exe = extension.is_some_and(|ext| ext.eq_ignore_ascii_case("exe"));
+    if !loader.is_absolute() || !loader.is_file() || !(batch || exe) {
+        bail!("Select an existing .bat or .exe loader file: {}", loader.display());
+    }
+    if batch && loader.to_string_lossy().contains(['%', '\r', '\n', '"']) {
+        bail!("The .bat loader path must have no percent signs or quotes: {}", loader.display());
+    }
+    Ok(Some(loader))
+}
+
+fn wait_custom_loader(
+    store: &Store,
+    game: &Path,
+    loader: &Path,
+    session: &Path,
+    before: &[u32],
+    env: &std::collections::BTreeMap<String, String>,
+    mut tick: impl FnMut(),
+) -> Result<()> {
+    wait_custom_loader_for(
+        store,
+        game,
+        loader,
+        session,
+        before,
+        env,
+        &mut tick,
+        Duration::from_secs(120),
+    )
+}
+
+#[allow(clippy::too_many_arguments)]
+fn wait_custom_loader_for(
+    store: &Store,
+    game: &Path,
+    loader: &Path,
+    session: &Path,
+    before: &[u32],
+    env: &std::collections::BTreeMap<String, String>,
+    tick: &mut impl FnMut(),
+    timeout: Duration,
+) -> Result<()> {
+    let stage = StageFile(store.root.join(steam_client::STAGE_FILE));
+    stage.set("Starting F1 25 through custom loader…");
+    say(
+        "info",
+        &format!(
+            "custom loader: {} (working folder {})",
+            loader.display(),
+            game.display()
+        ),
+    );
+    let log = session.join("custom_loader.log");
+    std::fs::File::create(&log)?;
+    let mut child = loader_process::spawn(game, loader, env, &log).context("starting the custom loader file")?;
+    let start = Instant::now();
+    let mut seen = false;
+    let mut stopped = false;
+    let mut loader_exit = None;
+    loop {
+        let running: Vec<_> = game_processes()
+            .into_iter()
+            .filter(|g| !before.contains(&g.pid) && g.is_in(game))
+            .collect();
+        if !running.is_empty() {
+            if !seen {
+                say("info", "custom loader: F1 25 started");
+                stage.set("F1 25 is running");
+            }
+            seen = true;
+        } else if seen {
+            break;
+        }
+        tick();
+        if loader_exit.is_none() {
+            loader_exit = child.try_wait()?;
+        }
+        if !seen && (ending() || loader_exit.is_some_and(|s| !s.success()) || start.elapsed() >= timeout) {
+            child.kill().ok();
+            child.wait().ok();
+            bail!(
+                "Custom loader did not start F1 25 (loader status: {:?}); see {}",
+                loader_exit,
+                session.join("custom_loader.log").display()
+            );
+        }
+        if seen && ending() && !stopped {
+            stopped = true;
+            for g in &running {
+                stop_process(g.pid).ok();
+            }
+        }
+        std::thread::sleep(Duration::from_millis(200));
+    }
+    // The loader may outlive the game. Reap it without treating its lifetime as the game's.
+    std::thread::spawn(move || child.wait().ok());
+    Ok(())
+}
