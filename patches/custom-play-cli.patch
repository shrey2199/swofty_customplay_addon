+use std::path::{Path, PathBuf};
+
+use swofty_core::session::LaunchConfig;
+
+#[test]
+fn custom_loader_settings_are_per_game_folder_and_old_settings_still_load() {
+    let mut config: LaunchConfig = serde_json::from_str("{}").unwrap();
+    assert!(config.custom_batch(Path::new("games/a")).is_none());
+    config
+        .custom_batches
+        .insert(PathBuf::from("games/a"), PathBuf::from("scripts/play.bat"));
+
+    let config: LaunchConfig = serde_json::from_str(&serde_json::to_string(&config).unwrap()).unwrap();
+    assert_eq!(
+        config.custom_batch(Path::new("games/a")),
+        Some(Path::new("scripts/play.bat"))
+    );
+    assert!(config.custom_batch(Path::new("games/b")).is_none());
+}
