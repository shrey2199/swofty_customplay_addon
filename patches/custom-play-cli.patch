+//! Windows process tests use a copy of cmd.exe as the game; no real game is started.
+use super::*;
+
+struct Fixture {
+    root: PathBuf,
+    store: Store,
+    game: PathBuf,
+    batch: PathBuf,
+    session: PathBuf,
+}
+
+impl Fixture {
+    fn new(script: &str) -> Self {
+        static NEXT: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+        let root = std::env::temp_dir().join(format!(
+            "swofty custom batch {} {}",
+            std::process::id(),
+            NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
+        ));
+        let game = root.join("game folder");
+        let session = root.join("session");
+        std::fs::create_dir_all(&game).unwrap();
+        std::fs::create_dir_all(&session).unwrap();
+        let batch = root.join("launch game.bat");
+        std::fs::write(&batch, script).unwrap();
+        let store = Store::new(root.join("data"));
+        Self {
+            root,
+            store,
+            game,
+            batch,
+            session,
+        }
+    }
+
+    fn run(&self) -> Result<()> {
+        let env = std::env::vars().collect();
+        wait_custom_loader_for(
+            &self.store,
+            &self.game,
+            &self.batch,
+            &self.session,
+            &[],
+            &env,
+            &mut || {},
+            Duration::from_secs(5),
+        )
+    }
+
+    fn install_mod(&self) -> Game {
+        let target = self.game.join("game_package/db.bin");
+        std::fs::create_dir_all(target.parent().unwrap()).unwrap();
+        std::fs::write(&target, "original").unwrap();
+        let source = self.root.join("mod.bin");
+        std::fs::write(&source, "modded").unwrap();
+        let game = Game {
+            identity: swofty_core::baseline::Identity::detect(&self.game, Some(1)).unwrap(),
+            dir: self.game.clone(),
+            user_reg: None,
+        };
+        let plan = swofty_core::install::Plan {
+            profile: "custom".into(),
+            data: [("game_package/db.bin".to_owned(), source)].into(),
+            ..Default::default()
+        };
+        Installer {
+            session: true,
+            ..Installer::new(&self.store.root, &game)
+        }
+        .apply(&plan)
+        .unwrap();
+        game
+    }
+}
+
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        stop_game_in(&self.game).ok();
+        std::fs::remove_dir_all(&self.root).ok();
+    }
+}
+
+#[test]
+fn detached_game_outlives_the_batch_and_is_waited_for_with_spaces_in_paths() {
+    let f = Fixture::new(
+        "@echo off\r\necho batch-output\r\nstart \"\" /b \"F1_25.exe\" /d /c \"ping -n 3 127.0.0.1 >nul\"\r\n",
+    );
+    let cmd = std::env::var_os("COMSPEC").unwrap();
+    std::fs::copy(cmd, f.game.join(GAME_EXE)).unwrap();
+    let game = f.install_mod();
+    let session = Session {
+        store: &f.store,
+        game: &game,
+        request_id: "custom".into(),
+        _lock: SessionLock::try_acquire(&f.store.root).unwrap().unwrap(),
+    };
+    let start = Instant::now();
+    let env = std::env::vars().collect();
+    let result = wait_custom_loader_for(
+        &f.store,
+        &f.game,
+        &f.batch,
+        &f.session,
+        &[],
+        &env,
+        &mut || {
+            assert_eq!(
+                std::fs::read_to_string(f.game.join("game_package/db.bin")).unwrap(),
+                "modded"
+            )
+        },
+        Duration::from_secs(5),
+    );
+    finish(session, result.map(|_| ExitCode::SUCCESS)).unwrap();
+    assert_eq!(
+        std::fs::read_to_string(f.game.join("game_package/db.bin")).unwrap(),
+        "original"
+    );
+    assert!(start.elapsed() >= Duration::from_secs(1));
+    assert!(!game_running_in(&f.game));
+    assert!(
+        std::fs::read_to_string(f.session.join("custom_loader.log"))
+            .unwrap()
+            .contains("batch-output")
+    );
+}
