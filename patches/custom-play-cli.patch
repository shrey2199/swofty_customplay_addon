+fn interrupted_session_keeps_mods_until_game_exit_and_can_be_recovered() {
+    let f = Fixture::new("@start \"\" /b \"F1_25.exe\" /d /c \"ping -n 3 127.0.0.1 >nul\"\r\n");
+    std::fs::copy(std::env::var_os("COMSPEC").unwrap(), f.game.join(GAME_EXE)).unwrap();
+    let game = f.install_mod();
+    let mut session = Some(Session {
+        store: &f.store,
+        game: &game,
+        request_id: "interrupted-custom".into(),
+        _lock: SessionLock::try_acquire(&f.store.root).unwrap().unwrap(),
+    });
+    let env = std::env::vars().collect();
+    wait_custom_loader_for(
+        &f.store,
+        &f.game,
+        &f.batch,
+        &f.session,
+        &[],
+        &env,
+        &mut || {
+            if game_running_in(&f.game) {
+                drop(session.take());
+            }
+            assert_eq!(
+                std::fs::read_to_string(f.game.join("game_package/db.bin")).unwrap(),
+                "modded"
+            );
+        },
+        Duration::from_secs(5),
+    )
+    .unwrap();
+    assert!(session.is_none());
+    assert!(
+        !swofty_core::journal::Journal::open(&f.store.root)
+            .unwrap()
+            .is_empty()
+    );
+    let lock = SessionLock::try_acquire(&f.store.root).unwrap().unwrap();
+    crate::recover::stale(&f.store, &lock, &game, Scope::All, &info).unwrap();
+    assert_eq!(
+        std::fs::read_to_string(f.game.join("game_package/db.bin")).unwrap(),
+        "original"
+    );
+}
