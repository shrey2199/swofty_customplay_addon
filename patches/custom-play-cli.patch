+//! Start an executable directly or use a hidden console for a batch loader.
+//! Batch commands such as `timeout` need a real console for stdin.
+use std::collections::BTreeMap;
+use std::io;
+use std::path::Path;
+
+#[cfg(not(windows))]
+pub(super) type LoaderChild = std::process::Child;
+
+#[cfg(not(windows))]
+pub(super) fn spawn(_: &Path, _: &Path, _: &BTreeMap<String, String>, _: &Path) -> io::Result<LoaderChild> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "Custom loader launch requires Windows",
+    ))
+}
+
+#[cfg(windows)]
+mod windows {
+    use super::*;
+    use std::ffi::c_void;
+    use std::os::windows::ffi::OsStrExt;
+    use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+    use std::os::windows::process::{CommandExt, ExitStatusExt};
+    use std::process::{Command, ExitStatus, Stdio};
+    use std::ptr::null;
+
+    type Handle = *mut c_void;
+
+    #[repr(C)]
+    struct StartupInfo {
+        cb: u32,
+        reserved: *mut u16,
+        desktop: *mut u16,
+        title: *mut u16,
+        x: u32,
+        y: u32,
+        width: u32,
+        height: u32,
+        x_chars: u32,
+        y_chars: u32,
+        fill: u32,
+        flags: u32,
+        show: u16,
+        reserved_len: u16,
+        reserved_bytes: *mut u8,
+        stdin: Handle,
+        stdout: Handle,
+        stderr: Handle,
+    }
+
+    #[repr(C)]
+    struct ProcessInfo {
+        process: Handle,
+        thread: Handle,
+        pid: u32,
+        tid: u32,
+    }
+
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn CreateProcessW(
+            app: *const u16,
+            command: *mut u16,
+            process_attrs: *const c_void,
+            thread_attrs: *const c_void,
+            inherit: i32,
+            flags: u32,
+            env: *const c_void,
+            cwd: *const u16,
+            startup: *const StartupInfo,
+            info: *mut ProcessInfo,
+        ) -> i32;
+        fn CloseHandle(handle: Handle) -> i32;
+        fn WaitForSingleObject(handle: Handle, milliseconds: u32) -> u32;
+        fn GetExitCodeProcess(handle: Handle, code: *mut u32) -> i32;
+        fn TerminateProcess(handle: Handle, code: u32) -> i32;
+    }
+
+    pub(in super::super) struct LoaderChild {
+        handle: OwnedHandle,
+    }
+
+    impl LoaderChild {
+        pub(in super::super) fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+            // SAFETY: OwnedHandle keeps this process handle valid for the call.
+            match unsafe { WaitForSingleObject(self.handle.as_raw_handle(), 0) } {
+                258 => Ok(None), // WAIT_TIMEOUT
+                0 => {
+                    let mut code = 0;
+                    // SAFETY: code is a writable DWORD and the process handle is valid.
+                    if unsafe { GetExitCodeProcess(self.handle.as_raw_handle(), &mut code) } == 0 {
+                        return Err(io::Error::last_os_error());
+                    }
+                    Ok(Some(ExitStatus::from_raw(code)))
+                }
+                _ => Err(io::Error::last_os_error()),
+            }
+        }
+
+        pub(in super::super) fn kill(&mut self) -> io::Result<()> {
+            // SAFETY: the owned handle refers only to the loader process we created.
+            if unsafe { TerminateProcess(self.handle.as_raw_handle(), 1) } == 0 {
+                return Err(io::Error::last_os_error());
+            }
+            Ok(())
+        }
+
+        pub(in super::super) fn wait(&mut self) -> io::Result<ExitStatus> {
+            // SAFETY: the handle remains owned throughout this blocking wait.
+            if unsafe { WaitForSingleObject(self.handle.as_raw_handle(), u32::MAX) } != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            self.try_wait()?
+                .ok_or_else(|| io::Error::other("loader process did not exit"))
+        }
+    }
+
+    fn wide(value: &std::ffi::OsStr) -> Vec<u16> {
+        value.encode_wide().chain(Some(0)).collect()
+    }
+
+    pub(in super::super) fn spawn(
+        game: &Path,
+        loader: &Path,
+        env: &BTreeMap<String, String>,
+        log: &Path,
+    ) -> io::Result<LoaderChild> {
+        if loader
+            .extension()
+            .is_some_and(|ext| ext.eq_ignore_ascii_case("exe"))
+        {
+            let output = std::fs::File::create(log)?;
+            let child = Command::new(loader)
+                .current_dir(game)
+                .env_clear()
+                .envs(env)
+                .stdin(Stdio::null())
+                .stdout(output.try_clone()?)
+                .stderr(output)
+                .creation_flags(0x0800_0000) // CREATE_NO_WINDOW for console executables
+                .spawn()?;
+            return Ok(LoaderChild { handle: child.into() });
+        }
+        let root = std::env::var_os("SystemRoot").ok_or_else(|| io::Error::other("SystemRoot is missing"))?;
+        let cmd = std::path::PathBuf::from(root).join("System32").join("cmd.exe");
+        let app = wide(cmd.as_os_str());
+        // Let Windows create console stdin with read/write access. Redirect only
+        // output in cmd: an inherited null or read-only stdin breaks timeout.exe.
+        let mut command = wide(std::ffi::OsStr::new(&format!(
+            "cmd.exe /d /v:off /s /c \"\"{}\" >\"%SWOFTY_BATCH_LOG%\" 2>&1\"",
+            loader.display()
+        )));
+        let cwd = wide(game.as_os_str());
+        let mut child_env = env.clone();
+        child_env.insert("SWOFTY_BATCH_LOG".to_owned(), log.to_string_lossy().into_owned());
+        let mut entries: Vec<_> = child_env.iter().collect();
+        entries.sort_by_key(|(name, _)| name.to_uppercase());
+        let mut block: Vec<u16> = entries
+            .iter()
+            .flat_map(|(k, v)| format!("{k}={v}\0").encode_utf16().collect::<Vec<_>>())
+            .collect();
+        if block.is_empty() {
+            block.push(0);
+        }
+        block.push(0);
+        // SAFETY: zero is valid for every optional pointer/flag in these Win32 structures.
+        let mut startup: StartupInfo = unsafe { std::mem::zeroed() };
+        startup.cb = std::mem::size_of::<StartupInfo>() as u32;
+        startup.flags = 0x00000001; // STARTF_USESHOWWINDOW; retain default console stdin
+        startup.show = 0; // SW_HIDE
+        let mut info: ProcessInfo = unsafe { std::mem::zeroed() };
+        // SAFETY: all wide strings/blocks are terminated and live through the call;
+        // structures have the Windows ABI layout. No parent handles are inherited.
+        let ok = unsafe {
+            CreateProcessW(
+                app.as_ptr(),
+                command.as_mut_ptr(),
+                null(),
+                null(),
+                0,
+                0x00000010 | 0x00000400, // CREATE_NEW_CONSOLE | CREATE_UNICODE_ENVIRONMENT
+                block.as_ptr().cast(),
+                cwd.as_ptr(),
+                &startup,
+                &mut info,
+            )
+        };
+        if ok == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: CreateProcessW returned two owned handles; the thread handle is
+        // unused, and OwnedHandle takes responsibility for the process handle.
+        unsafe {
+            CloseHandle(info.thread);
+        }
+        Ok(LoaderChild {
+            handle: unsafe { OwnedHandle::from_raw_handle(info.process) },
+        })
+    }
+}
+
+#[cfg(windows)]
+pub(super) use windows::spawn;
