+fn wait_custom_loader(
+    store: &Store,
+    game: &Path,
+    loader: &Path,
+    session: &Path,
+    before: &[u32],
+    env: &BTreeMap<String, String>,
+    mut tick: impl FnMut(),
+) -> Result<()> {
+    use crate::stores::steam::StageFile;
+    use swofty_core::platform::steam::client as steam_client;
+
+    let stage = StageFile(store.root.join(steam_client::STAGE_FILE));
+    stage.set("Starting F1 25 through custom loader…");
+    let log = session.join("custom_loader.log");
+    std::fs::File::create(&log)?;
+    say(
+        "info",
+        &format!(
+            "custom loader: {} (working folder {})",
+            loader.display(),
+            game.display()
+        ),
+    );
+    let mut child = loader_process::spawn(game, loader, env, &log)
+        .map_err(|e| anyhow::anyhow!("starting the custom loader file: {e}"))?;
+    let start = Instant::now();
+    let mut seen = false;
+    let mut stopped = false;
+    let mut loader_exit = None;
+    loop {
+        let running: Vec<_> = game_processes()
+            .into_iter()
+            .filter(|g| !before.contains(&g.pid) && g.is_in(game))
+            .collect();
+        if !running.is_empty() {
+            if !seen {
+                say("info", "custom loader: F1 25 started");
+                stage.set("F1 25 is running");
+            }
+            seen = true;
+        } else if seen {
+            break;
+        }
+        tick();
+        if loader_exit.is_none() {
+            loader_exit = child.try_wait()?;
+        }
+        if !seen
+            && (ending()
+                || loader_exit.is_some_and(|status| !status.success())
+                || start.elapsed() >= Duration::from_secs(120))
+        {
+            child.kill().ok();
+            child.wait().ok();
+            bail!(
+                "Custom loader did not start F1 25 (loader status: {loader_exit:?}); see {}",
+                log.display()
+            );
+        }
+        if seen && ending() && !stopped {
+            stopped = true;
+            say(
+                "info",
+                "asked to stop: closing F1 25, then rolling its game files back",
+            );
+            for game_process in &running {
+                stop_process(game_process.pid).ok();
+            }
+        }
+        std::thread::sleep(Duration::from_millis(250));
+    }
+    // A loader may outlive F1 25; reap it without making its lifetime the game session.
+    std::thread::spawn(move || child.wait().ok());
+    Ok(())
+}
